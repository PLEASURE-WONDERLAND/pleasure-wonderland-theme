<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
  .pw-cat{background:{{ section.settings.bg }};padding:clamp(48px,6vw,88px) 0}
  .pw-cat__head{text-align:center;margin:0 auto 40px;max-width:620px}
  .pw-cat__eyebrow{font-size:12px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:#8A6A43;margin:0 0 12px}
  .pw-cat__title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(36px,4vw,56px);line-height:1.05;margin:0;color:#121012}
  .pw-cat__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 22px}
  .pw-cat__tile{display:block;text-decoration:none;color:#121012}
  .pw-cat__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:#E9D8BC}
  .pw-cat__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
  .pw-cat__tile:hover .pw-cat__media img{transform:scale(1.04)}
  .pw-cat__label{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-top:14px}
  .pw-cat__name{font-family:'Cormorant Garamond',Georgia,serif;font-size:28px;font-weight:500;line-height:1.1}
  .pw-cat__go{font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#5C1426;white-space:nowrap}
  .pw-cat__note{display:block;font-size:14px;color:#5b5257;margin-top:4px}
  @media (max-width:899px){.pw-cat__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 14px}.pw-cat__name{font-size:22px}.pw-cat__go{display:none}}
</style>
<section class="pw-cat">
  <div class="pw-wrap">
    <div class="pw-cat__head">
      {%- if section.settings.eyebrow != blank -%}<p class="pw-cat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="pw-cat__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="pw-cat__grid">
      {%- for block in section.blocks -%}
        <a class="pw-cat__tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="pw-cat__media">
            {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 900px) 31vw, 47vw', alt: block.settings.image.alt, style: 'object-position:' | append: block.settings.pos }}{%- endif -%}
          </div>
          <div class="pw-cat__label"><span class="pw-cat__name">{{ block.settings.title }}</span><span class="pw-cat__go">Shop now</span></div>
          {%- if block.settings.note != blank -%}<span class="pw-cat__note">{{ block.settings.note }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Shop by category",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your thing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F7F1E8" }
  ],
  "blocks": [{ "type": "tile", "name": "Category", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "For Her" },
    { "type": "text", "id": "note", "label": "Short note" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "pos", "label": "Image focus", "default": "center" }
  ]}],
  "presets": [{ "name": "PW Shop by category" }]
}
{% endschema %}
