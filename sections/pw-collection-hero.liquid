{%- assign c = collection -%}
{%- case c.handle -%}
  {%- when 'the-control-room' -%}{%- assign pw_pos = '50% 18%' -%}
  {%- when 'for-couples' -%}{%- assign pw_pos = '50% 42%' -%}
  {%- when 'the-backdoor' -%}{%- assign pw_pos = '50% 30%' -%}
  {%- when 'for-him' -%}{%- assign pw_pos = '50% 30%' -%}
  {%- when 'for-her' -%}{%- assign pw_pos = '50% 30%' -%}
  {%- else -%}{%- assign pw_pos = '50% 50%' -%}
{%- endcase -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
  .pw-colban{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);background:#121012;color:#F7F1E8;margin-bottom:28px}
  .pw-colban__copy{display:flex;flex-direction:column;justify-content:center;padding:48px clamp(22px,4.5vw,72px)}
  .pw-colban__crumb{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#B89668;margin:0 0 18px}
  .pw-colban__crumb a{color:inherit;text-decoration:none}
  .pw-colban__title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(42px,5vw,72px);line-height:1.02;margin:0 0 14px;color:#F7F1E8}
  .pw-colban__desc{color:rgba(247,241,232,.78);font-size:16px;line-height:1.6;max-width:460px}
  .pw-colban__desc p{margin:0 0 8px}
  .pw-colban__guide{margin-top:18px;color:#E9D8BC;font-weight:600;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
  .pw-colban__media{position:relative;min-height:420px;overflow:hidden}
  .pw-colban__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  @media (max-width:899px){.pw-colban{grid-template-columns:1fr}.pw-colban__media{order:-1;min-height:0;aspect-ratio:16/10}.pw-colban__copy{padding:28px 22px 32px}}
</style>
{%- if c.image -%}
<div class="pw-colban">
  <div class="pw-colban__copy">
    <p class="pw-colban__crumb"><a href="{{ routes.root_url }}">Home</a> / {{ c.title }}</p>
    <h1 class="pw-colban__title">{{ c.title }}</h1>
    {%- if c.description != blank -%}<div class="pw-colban__desc">{{ c.description }}</div>{%- endif -%}
    {%- if section.settings.guide_label != blank and section.settings.guide_link != blank -%}<a href="{{ section.settings.guide_link }}" class="pw-colban__guide">{{ section.settings.guide_label }} →</a>{%- endif -%}
  </div>
  <div class="pw-colban__media">
    {{ c.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800', sizes: '(min-width: 900px) 58vw, 100vw', alt: c.image.alt, style: 'object-position:' | append: pw_pos }}
  </div>
</div>
{%- endif -%}
<section class="pw-section" style="--pw-pad-top: {% if c.image %}0{% else %}28{% endif %}px; --pw-pad-bottom: 8px">
  <div class="pw-wrap">
    {%- unless c.image -%}
    <nav aria-label="Breadcrumb" class="pw-muted" style="font-size: 13px; margin-bottom: 18px"><a href="{{ routes.root_url }}" style="color: inherit">Home</a> / {{ c.title }}</nav>
    <div class="pw-colhero">
      <div style="max-width: 640px">
        <h1 class="pw-h" style="font-size: clamp(40px, 5vw, 56px); margin-bottom: 10px">{{ c.title }}</h1>
        {%- if c.description != blank -%}<div class="pw-muted pw-rte">{{ c.description }}</div>{%- endif -%}
      </div>
      {%- if section.settings.guide_label != blank and section.settings.guide_link != blank -%}
        <a href="{{ section.settings.guide_link }}" class="pw-colhero__guide"><span>{{ section.settings.guide_label }}</span><span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
    {%- endunless -%}
    {%- capture chips -%}
      {%- for block in section.blocks -%}
        {%- assign tag = block.settings.tag | handleize -%}
        {%- if c.all_tags contains tag -%}
          <a href="{{ c.url }}/{{ tag }}" class="pw-chip{% if current_tags contains tag %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if chips != blank -%}
      <div class="pw-colhero__chips">
        <a href="{{ c.url }}" class="pw-chip{% if current_tags == blank %} is-active{% endif %}">All {{ c.products_count }}</a>
        {{ chips }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PW Collection header",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "guide_label", "label": "Guide link label", "default": "Compare toys side by side" },
    { "type": "url", "id": "guide_link", "label": "Guide link" }
  ],
  "blocks": [{
    "type": "chip", "name": "Quick filter",
    "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Air-pulse" },
      { "type": "text", "id": "tag", "label": "Product tag", "default": "air-pulse", "info": "Only shows when products in this collection have this tag." }
    ]
  }],
  "presets": [{ "name": "PW Collection header" }]
}
{% endschema %}
