<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    {%- if section.settings.heading != blank -%}<div class="pw-section-head"><h2 class="pw-h">{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="pw-vibes">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="pw-vibe" style="background: {{ block.settings.bg }}; color: {{ block.settings.fg }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- endif -%}
          <span class="pw-vibe__title" style="color: {{ block.settings.fg }}">{{ block.settings.title }}</span>
          <span class="pw-vibe__text">{{ block.settings.text }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Shop by vibe",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by vibe" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 }
  ],
  "blocks": [{
    "type": "tile", "name": "Tile",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "For Her" },
      { "type": "text", "id": "text", "label": "Text", "default": "Air-pulse, bullets, wands" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
      { "type": "color", "id": "bg", "label": "Background", "default": "#E9E1FF" },
      { "type": "color", "id": "fg", "label": "Text colour", "default": "#1D1530" }
    ]
  }],
  "presets": [{
    "name": "PW Shop by vibe",
    "blocks": [
      { "type": "tile", "settings": { "title": "For Her", "text": "Air-pulse, bullets, wands", "bg": "#E9E1FF" } },
      { "type": "tile", "settings": { "title": "For Him", "text": "Strokers, sleeves, rings", "bg": "#DCE8FF" } },
      { "type": "tile", "settings": { "title": "For Couples", "text": "Remote and app play", "bg": "#FFD9D3" } },
      { "type": "tile", "settings": { "title": "The Control Room", "text": "Tease, restrain, play", "bg": "#1D1530", "fg": "#FFFFFF" } },
      { "type": "tile", "settings": { "title": "Lube & Care", "text": "The essentials", "bg": "#DDF2EA" } }
    ]
  }]
}
{% endschema %}
