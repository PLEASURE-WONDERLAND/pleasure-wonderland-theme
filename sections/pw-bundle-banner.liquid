{%- liquid
  assign keys = 'curious'
  if template.name == 'collection'
    case collection.handle
      when 'for-him'
        assign keys = 'mens'
      when 'for-couples'
        assign keys = 'together,spice'
      when 'the-backdoor'
        assign keys = 'backdoor'
      when 'the-control-room'
        assign keys = 'intro'
      when 'bundles'
        assign keys = ''
    endcase
  endif
  if section.settings.mode == 'custom'
    assign keys = 'custom'
  endif
  assign key_list = keys | split: ','
-%}
{%- for key in key_list -%}
  {%- liquid
    assign kit = blank
    assign pill = ''
    assign link = ''
    assign img = blank
    assign was = ''
    case key
      when 'curious'
        assign kit = all_products['the-curious-kit']
        assign heading = 'The Curious Kit'
        assign text = 'The easiest way to start. Satisfyer Pro 2 and Wicked lube, with a vibrating bullet on us.'
        assign lines = 'Satisfyer Pro 2 air-pulse toy|$54.95;Wicked Simply Aqua lube 120 ml|$19.95;B Yours vibrating bullet|FREE'
        assign button = 'Shop the Curious Kit'
      when 'mens'
        assign kit = all_products['the-mens-room-kit']
        assign heading = "The Men's Room Kit"
        assign text = 'A warming, vibrating Satisfyer stroker with lube, and the toy cleaner is on us.'
        assign lines = 'Satisfyer Men Heat Vibration|$84.95;Wicked Simply Aqua lube 120 ml|$19.95;Wicked toy cleaner|FREE'
        assign button = "Shop the Men's Room Kit"
      when 'together'
        assign kit = all_products['the-together-kit']
        assign heading = 'The Together Kit'
        assign text = 'Your first toys for two. Satisfyer Endless Joy for foreplay and a free vibrating ring for sex.'
        assign lines = 'Satisfyer Endless Joy couples vibrator|$59.95;Wicked Simply Aqua lube 120 ml|$19.95;Vibrating couples ring|FREE'
        assign button = 'Shop the Together Kit'
      when 'intro'
        assign kit = all_products['the-introduction']
        assign heading = 'New here? Start with The Introduction'
        assign text = 'Sensory play and light restraint, nothing scary. Five pieces in one plain box.'
        assign lines = 'Fur-lined wrist cuffs|$26.95;Satin blindfold|$14.95;Feather tickler|$14.95;Sensory fingertips|$19.95;Large storage bag|$14.95'
        assign button = 'Shop The Introduction'
      when 'backdoor'
        assign kit = all_products['the-backdoor-kit']
        assign heading = 'The Backdoor Kit'
        assign text = 'A beginner vibrating plug and the thick anal lube it needs, with toy cleaner on us.'
        assign lines = 'Satisfyer Backdoor Lover|$49.95;Wicked Jelle anal lube 120 ml|$21.95;Wicked toy cleaner|FREE'
        assign button = 'Shop the Backdoor Kit'
      when 'spice'
        assign pill = 'The Control Room'
        assign heading = 'Want to spice it up?'
        assign text = 'Blindfolds, cuffs and beginner kits for couples who want to try a little kink. Everything is soft, adjustable and easy to take off.'
        assign lines = 'The Introduction|Beginner kit;The Restraint|Cuffs, collar, bed straps;The Impact|Flogger, paddle, crop'
        assign button = 'Explore The Control Room'
        assign link = '/collections/the-control-room'
        assign price = 'Kits from $69.95'
        assign img = all_products['the-control-room'].featured_image
      when 'custom'
        assign pill = section.settings.pill
        assign heading = section.settings.heading
        assign text = section.settings.text
        assign button = section.settings.button
        assign link = section.settings.link
        assign price = section.settings.price
        assign was = section.settings.was
        assign img = section.settings.image
    endcase
    if kit != blank and kit.id
      assign link = kit.url
      assign price = kit.price | money_without_trailing_zeros
      if kit.compare_at_price > kit.price
        assign was = kit.compare_at_price | money_without_trailing_zeros
        assign saving = kit.compare_at_price | minus: kit.price | money_without_trailing_zeros
        assign pill = 'Save ' | append: saving
        if lines contains 'FREE'
          assign pill = pill | append: ' + free gift'
        endif
      endif
      assign img = kit.featured_image
    endif
  -%}
  {%- if key == 'custom' or link != '' -%}
<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    <div class="pw-bundle">
      <div class="pw-bundle__copy">
        {%- if pill != blank -%}<span class="pw-pill pw-pill--coral">{{ pill }}</span>{%- endif -%}
        <h2 class="pw-h">{{ heading }}</h2>
        <p>{{ text }}</p>
        <ul class="pw-bundle__list">
          {%- if key == 'custom' -%}
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span>{{ block.settings.item }}</span><span>{{ block.settings.value }}</span></li>
            {%- endfor -%}
          {%- else -%}
            {%- assign rows = lines | split: ';' -%}
            {%- for row in rows -%}
              {%- assign cells = row | split: '|' -%}
              <li><span>{{ cells[0] }}</span>{%- if cells[1] == 'FREE' -%}<span style="background:#FF7A6B;color:#fff;border-radius:999px;padding:2px 12px;font-weight:700">FREE</span>{%- else -%}<span>{{ cells[1] }}</span>{%- endif -%}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        <div class="pw-bundle__price">
          <div><strong style="font-size:1.35em">{{ price }}</strong>{%- if was != blank -%}<s>{{ was }}</s>{%- endif -%}</div>
          <a href="{{ link | default: '#' }}" class="pw-btn pw-btn--light">{{ button }}</a>
        </div>
      </div>
      <div class="pw-bundle__art">
        {%- if img != blank -%}
          {{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: heading }}
        {%- else -%}
          <div class="pw-shape" style="width: 70px; height: 190px; background: #FF7A6B"></div>
          <div style="width: 90px; height: 150px; background: #E9E1FF; border-radius: 22px"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
  {%- endif -%}
{%- endfor -%}

{% schema %}
{
  "name": "PW Bundle banner",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "mode", "label": "Content", "options": [{ "value": "auto", "label": "Auto: matching kit for this page" }, { "value": "custom", "label": "Custom" }], "default": "auto" },
    { "type": "text", "id": "pill", "label": "Pill", "default": "Save $7.90" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Curious Kit" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "price", "label": "Bundle price" },
    { "type": "text", "id": "was", "label": "Was price" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop the kit" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [{
    "type": "line", "name": "Kit item",
    "settings": [
      { "type": "text", "id": "item", "label": "Item" },
      { "type": "text", "id": "value", "label": "Value" }
    ]
  }],
  "presets": [{ "name": "PW Bundle banner" }]
}
{% endschema %}
