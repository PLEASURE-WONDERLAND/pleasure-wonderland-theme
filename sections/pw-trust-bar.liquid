<section class="pw-trust">
  <div class="pw-wrap pw-trust__grid">
    {%- for block in section.blocks -%}
      <div class="pw-trust__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'box' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>
          {%- when 'fast' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12h11M10 6l6 6-6 6"/><path d="M18 5v14"/></svg>
          {%- when 'battery' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="8" width="16" height="9" rx="3"/><path d="M9 12.5h6"/></svg>
          {%- else -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        {%- endcase -%}
        <div><div class="pw-trust__title">{{ block.settings.title }}</div><div class="pw-trust__text">{{ block.settings.text }}</div></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "PW Trust bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "box", "label": "Plain box" }, { "value": "fast", "label": "Fast" },
          { "value": "battery", "label": "Battery" }, { "value": "shield", "label": "Shield" }
        ], "default": "box" },
        { "type": "text", "id": "title", "label": "Title", "default": "Plain-box delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "No logos, no clues" }
      ]
    }
  ],
  "presets": [{
    "name": "PW Trust bar",
    "blocks": [
      { "type": "item", "settings": { "icon": "box", "title": "Plain-box delivery", "text": "No logos, no clues" } },
      { "type": "item", "settings": { "icon": "fast", "title": "Fast Aussie dispatch", "text": "Order by 2pm for same-day dispatch" } },
      { "type": "item", "settings": { "icon": "battery", "title": "USB-C rechargeable", "text": "Across our own range" } },
      { "type": "item", "settings": { "icon": "shield", "title": "[Warranty] warranty", "text": "Discreet billing name" } }
    ]
  }]
}
{% endschema %}
