<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap" style="max-width: 860px">
    {%- if section.settings.heading != blank -%}<h2 class="pw-h" style="font-size: clamp(26px, 3vw, 32px); margin-bottom: 12px">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="pw-muted pw-rte" style="margin-bottom: 18px">{{ section.settings.intro }}</div>{%- endif -%}
    {%- for block in section.blocks -%}
      <details class="pw-acc" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="pw-muted pw-rte">{{ block.settings.answer }}</div></details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "PW FAQ",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [{
    "type": "qa", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How discreet is delivery?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Plain outer box, neutral return address and a discreet billing name.</p>" }
    ]
  }],
  "presets": [{ "name": "PW FAQ" }]
}
{% endschema %}
