<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
  #pwf-{{ section.id }}{background:{{ section.settings.bg }};color:{{ section.settings.fg }}}
  .pw-feat__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:stretch}
  .pw-feat--rev .pw-feat__media{order:2}
  .pw-feat__media{position:relative;min-height:560px;overflow:hidden}
  .pw-feat__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pw-feat__copy{display:flex;flex-direction:column;justify-content:center;padding:72px clamp(24px,6vw,96px)}
  .pw-feat__eyebrow{font-size:12px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:{{ section.settings.accent }};margin:0 0 18px}
  .pw-feat__title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(40px,4.4vw,68px);line-height:1.04;margin:0 0 20px;color:inherit}
  .pw-feat__text{font-size:17px;line-height:1.65;opacity:.82;max-width:480px;margin:0 0 26px}
  .pw-feat__list{list-style:none;padding:0;margin:0 0 32px;display:grid;gap:10px;max-width:480px}
  .pw-feat__list li{display:flex;justify-content:space-between;gap:16px;padding-bottom:10px;border-bottom:1px solid currentColor;border-color:color-mix(in srgb,currentColor 18%,transparent);font-size:15px}
  .pw-feat__list li span:last-child{opacity:.7}
  #pwf-{{ section.id }} .pw-lux-btn{background:{{ section.settings.btn_bg }};color:{{ section.settings.btn_fg }};display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;font-size:13px;text-decoration:none;border-radius:2px;align-self:flex-start}
  @media (max-width:899px){.pw-feat__grid{grid-template-columns:1fr}.pw-feat__media,.pw-feat--rev .pw-feat__media{order:-1;min-height:0;aspect-ratio:4/4.4}.pw-feat__copy{padding:38px 22px 50px}#pwf-{{ section.id }} .pw-lux-btn{align-self:stretch}}
</style>
<section id="pwf-{{ section.id }}">
  <div class="pw-feat__grid{% if section.settings.reverse %} pw-feat--rev{% endif %}">
    <div class="pw-feat__media">
      {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.image.alt, style: 'object-position:' | append: section.settings.pos }}{%- endif -%}
    </div>
    <div class="pw-feat__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="pw-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="pw-feat__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="pw-feat__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="pw-feat__list">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.left }}</span><span>{{ block.settings.right }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="pw-lux-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Feature split",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "pos", "label": "Image focus", "default": "center" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Control Room" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#5C1426" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#F7F1E8" },
    { "type": "color", "id": "accent", "label": "Eyebrow colour", "default": "#E9D8BC" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#E9D8BC" },
    { "type": "color", "id": "btn_fg", "label": "Button text", "default": "#121012" }
  ],
  "blocks": [{ "type": "row", "name": "List row", "settings": [
    { "type": "text", "id": "left", "label": "Left", "default": "The Introduction" },
    { "type": "text", "id": "right", "label": "Right", "default": "Beginner" }
  ]}],
  "presets": [{ "name": "PW Feature split" }]
}
{% endschema %}
