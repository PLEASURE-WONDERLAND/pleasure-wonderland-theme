<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
  .pw-ed{background:#121012;color:#F7F1E8}
  .pw-ed__grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);min-height:min(80vh,780px)}
  .pw-ed__copy{display:flex;flex-direction:column;justify-content:center;padding:64px clamp(24px,5vw,88px)}
  .pw-ed__eyebrow{font-size:12px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:#B89668;margin:0 0 22px}
  .pw-ed__title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(44px,5.2vw,84px);line-height:1.03;margin:0 0 22px;color:#F7F1E8;letter-spacing:-.01em}
  .pw-ed__title em{font-style:italic;color:#E9D8BC}
  .pw-ed__sub{font-size:17px;line-height:1.6;color:rgba(247,241,232,.78);max-width:440px;margin:0 0 34px}
  .pw-ed__ctas{display:flex;gap:14px;flex-wrap:wrap}
  .pw-lux-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;font-size:13px;text-decoration:none;border-radius:2px;transition:background .2s,color .2s}
  .pw-lux-btn--solid{background:#E9D8BC;color:#121012}
  .pw-lux-btn--solid:hover{background:#F7F1E8}
  .pw-lux-btn--line{border:1px solid rgba(233,216,188,.55);color:#F7F1E8}
  .pw-lux-btn--line:hover{background:rgba(233,216,188,.12)}
  .pw-ed__media{position:relative;min-height:440px;overflow:hidden}
  .pw-ed__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.pos }}}
  /* Home luxe refinements */
  .pw-warranty__badge small{width:auto!important;flex:none!important;align-self:stretch!important;padding:0 6px;letter-spacing:.12em}
  .pw-warranty{background:#F7F1E8!important}
  .pw-warranty__badge{background:#5C1426!important;padding:30px!important;width:clamp(220px,22vw,300px)!important;height:auto!important;aspect-ratio:1!important;flex-shrink:0!important;margin-inline:auto!important}
  .pw-warranty__badge small{color:#E9D8BC!important}
  .pw-warranty .pw-eyebrow,.pw-usp .pw-eyebrow{color:#8A6A43!important}
  .pw-usp__item{background:#F7F1E8!important}
  .pw-section-head .pw-h,.pw-usp .pw-h,.pw-warranty .pw-h,.pw-news .pw-h{font-family:'Cormorant Garamond',Georgia,serif!important;font-weight:500!important;letter-spacing:0!important;color:#121012}
  .pw-section-head .pw-h{font-size:clamp(34px,3.6vw,52px)!important}
  .pw-news{background:#121012!important;color:#F7F1E8}
  .pw-news .pw-h{color:#F7F1E8!important}
  .pw-news .pw-muted{color:rgba(247,241,232,.75)!important}
  .pw-news .pw-btn{background:#E9D8BC!important;color:#121012!important}
  .pw-brands__row{gap:10px 0}
  .pw-brands__row a{border-left:0!important;padding:4px clamp(14px,2vw,28px)}
  @media (max-width:899px){
    .pw-ed__grid{grid-template-columns:1fr;min-height:0}
    .pw-ed__media{order:-1;min-height:0;aspect-ratio:4/3.6}
    .pw-ed__copy{padding:34px 22px 46px}
    .pw-ed__ctas .pw-lux-btn{flex:1 1 100%}
  }
</style>
<section class="pw-ed">
  <div class="pw-ed__grid">
    <div class="pw-ed__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="pw-ed__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="pw-ed__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="pw-ed__sub">{{ section.settings.text }}</p>{%- endif -%}
      <div class="pw-ed__ctas">
        {%- if section.settings.cta1_label != blank -%}<a class="pw-lux-btn pw-lux-btn--solid" href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}">{{ section.settings.cta1_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="pw-lux-btn pw-lux-btn--line" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="pw-ed__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '(min-width: 900px) 58vw, 100vw', alt: section.settings.image.alt }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Editorial hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Campaign image" },
    { "type": "text", "id": "pos", "label": "Image focus (CSS object-position)", "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The night-in edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bedside drawer deserves an <em>upgrade.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Toys and intimate essentials from brands you know, shipped fast from Australia in a plain box." },
    { "type": "text", "id": "cta1_label", "label": "Button 1", "default": "Shop bestsellers" },
    { "type": "url", "id": "cta1_link", "label": "Button 1 link" },
    { "type": "text", "id": "cta2_label", "label": "Button 2", "default": "Explore The Control Room" },
    { "type": "url", "id": "cta2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "PW Editorial hero" }]
}
{% endschema %}
