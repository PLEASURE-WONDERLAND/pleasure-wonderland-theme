<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    <div class="pw-news">
      <div class="pw-news__copy">
        <h2 class="pw-h">{{ section.settings.heading }}</h2>
        <p class="pw-muted" style="margin: 0; font-size: 17px">{{ section.settings.text }}</p>
      </div>
      {%- form 'customer', class: 'pw-news__form', id: 'pw-news-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,welcome20">
        {%- if form.posted_successfully? -%}
          <p class="pw-news__msg" role="status">{{ section.settings.success }}</p>
        {%- else -%}
          <label for="pw-news-email" class="pw-sr">Email address</label>
          <input id="pw-news-email" type="email" name="contact[email]" placeholder="you@email.com" required autocomplete="email">
          <button type="submit" class="pw-btn pw-btn--dark" style="min-height: 52px">{{ section.settings.button }}</button>
          {%- if form.errors -%}<p class="pw-news__msg" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "20% off your first order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the list for the code. Orders over $79, max discount $40. Emails come from a discreet sender name." },
    { "type": "text", "id": "button", "label": "Button", "default": "Get my code" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're in. Check your inbox for WELCOME20." },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "PW Newsletter" }]
}
{% endschema %}
