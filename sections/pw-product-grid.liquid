<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    <div class="pw-section-head">
      <h2 class="pw-h">{{ section.settings.heading }}</h2>
      {%- if section.settings.collection != blank -%}<a href="{{ section.settings.collection.url }}" style="font-weight: 600">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="pw-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {%- render 'pw-product-card', product: product, tint: section.settings.tint -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="pw-card"><div class="pw-card__media" style="background: {{ section.settings.tint }}">{{ 'product-1' | placeholder_svg_tag: 'pw-placeholder' }}</div><div class="pw-card__body"><span class="pw-card__title">Product name</span><span class="pw-card__price">$0.00</span></div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "color", "id": "tint", "label": "Card tint", "default": "#E9E1FF" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "PW Product grid" }]
}
{% endschema %}
