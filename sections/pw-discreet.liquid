<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  {%- liquid
    assign pw_sender = section.settings.sender
    if pw_sender == blank or pw_sender contains '['
      assign pw_sender = 'PWD'
    endif
    assign pw_desc = section.settings.descriptor
    if pw_desc == blank or pw_desc contains '['
      assign pw_desc = 'A discreet business name'
    endif
  -%}
  <div class="pw-wrap pw-discreet">
    <div class="pw-discreet__art" aria-hidden="true">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
      {%- else -%}
        <div class="pw-box">
          <div class="pw-box__label">
            <span>TO: You</span>
            <span>FROM: {{ pw_sender }}</span>
          </div>
          <div class="pw-box__tape"></div>
        </div>
        <div class="pw-statement">
          <span class="pw-muted" style="font-size: 12px">Bank statement</span>
          <strong>{{ pw_desc }}</strong>
        </div>
      {%- endif -%}
    </div>
    <div class="pw-discreet__copy">
      <div class="pw-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="pw-h" style="font-size: clamp(30px, 3.5vw, 44px); margin: 10px 0 20px">{{ section.settings.heading }}</h2>
      <ul class="pw-ticks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            <span><strong>{{ block.settings.title }}</strong> {{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Discreet delivery",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discreet, always" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What actually turns up at your door" },
    { "type": "text", "id": "sender", "label": "Sender name on the box", "default": "PWD" },
    { "type": "text", "id": "descriptor", "label": "Bank statement name", "default": "A discreet business name" },
    { "type": "image_picker", "id": "image", "label": "Photo of the real parcel (optional)" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [{ "type": "tick", "name": "Point", "settings": [
    { "type": "text", "id": "title", "label": "Bold part", "default": "Plain box." },
    { "type": "text", "id": "text", "label": "Text", "default": "No logos, no product names." }
  ]}],
  "presets": [{ "name": "PW Discreet delivery" }]
}
{% endschema %}
