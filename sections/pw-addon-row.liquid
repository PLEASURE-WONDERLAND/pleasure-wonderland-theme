{%- assign src = section.settings.collection -%}
{%- if src != blank and src.products_count > 0 -%}
<section class="pw-section" style="--pw-pad-top: 24px; --pw-pad-bottom: 40px">
  <div class="pw-wrap">
    <div class="pw-addons">
      <div class="pw-h" style="font-size: 26px">{{ section.settings.heading }}</div>
      <div class="pw-muted" style="font-size: 15px; margin-bottom: 20px">{{ section.settings.text }}</div>
      <div class="pw-addons__grid">
        {%- for p in src.products limit: section.settings.limit -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          <div class="pw-addon">
            <a href="{{ p.url }}" class="pw-addon__img" aria-label="{{ p.title | escape }}">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}</a>
            <div style="flex: 1; min-width: 0"><a href="{{ p.url }}" style="font-weight: 600; font-size: 15px; color: inherit; text-decoration: none">{{ p.title }}</a><div class="pw-muted" style="font-size: 14px">{{ v.price | money }}</div></div>
            {%- if v.available -%}
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="1">
                <button type="submit" class="pw-chip" aria-label="Add {{ p.title | escape }}" style="padding: 0; width: 44px; justify-content: center">+</button>
              </form>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "PW Add-on row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't forget the essentials" },
    { "type": "text", "id": "text", "label": "Text", "default": "Most people add one of these. Same plain box, no extra shipping." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "PW Add-on row" }]
}
{% endschema %}
