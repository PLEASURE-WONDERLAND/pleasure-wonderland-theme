<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    <div class="pw-offer">
      <div class="pw-offer__badge" aria-hidden="true"><span>{{ section.settings.big }}</span><small>{{ section.settings.big_sub }}</small></div>
      <div class="pw-offer__copy">
        <h2 class="pw-h">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      {%- form 'customer', class: 'pw-offer__form', id: 'pw-offer-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,welcome20,offer-band">
        {%- if form.posted_successfully? -%}
          <div class="pw-code" role="status" data-pw-apply-code="{{ section.settings.code | escape }}">
            <span>Your code</span>
            <strong>{{ section.settings.code }}</strong>
            <small>Already applied to your cart. It comes off at checkout.</small>
          </div>
        {%- else -%}
          <label for="pw-offer-email" class="pw-sr">Email address</label>
          <input id="pw-offer-email" type="email" name="contact[email]" placeholder="you@email.com" required autocomplete="email">
          <button type="submit" class="pw-btn pw-btn--coral" style="min-height: 52px">{{ section.settings.button }}</button>
          <small class="pw-offer__terms">{{ section.settings.terms }}</small>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Offer band",
  "settings": [
    { "type": "text", "id": "big", "label": "Big number", "default": "20%" },
    { "type": "text", "id": "big_sub", "label": "Under the number", "default": "OFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New here? Take 20% off your first order." },
    { "type": "text", "id": "text", "label": "Text", "default": "Pop in your email and we'll show your code straight away. Emails come from a discreet sender name." },
    { "type": "text", "id": "button", "label": "Button", "default": "Reveal my code" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "WELCOME20" },
    { "type": "text", "id": "terms", "label": "Terms", "default": "First order only. Min spend $79, max discount $40." },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "PW Offer band" }]
}
{% endschema %}
