<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    <div class="pw-finder__head">
      <div class="pw-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="pw-h">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="pw-muted" style="font-size: 17px; margin: 12px 0 0">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="pw-steps">
      {%- for block in section.blocks -%}
        <li class="pw-step" {{ block.shopify_attributes }}>
          <span class="pw-step__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "PW How we test",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How a toy earns its place" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fewer products. Properly tested." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Most stores list thousands of products. We list the ones that pass." },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "We read the reviews" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Especially the bad ones." }
  ]}],
  "presets": [{ "name": "PW How we test" }]
}
{% endschema %}
