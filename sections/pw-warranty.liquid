<style>
  .pw-warranty__badge{display:flex!important;flex-direction:column!important;align-items:center;justify-content:center;text-align:center;box-sizing:border-box;padding:30px!important;width:clamp(220px,22vw,300px)!important;height:auto!important;aspect-ratio:1!important;flex-shrink:0!important;margin-inline:auto!important;overflow:hidden}
  .pw-warranty__badge span{line-height:1;display:block}
  .pw-warranty__badge small{display:block;align-self:stretch;width:auto!important;margin-top:10px;font-size:clamp(14px,1.3vw,18px)!important;line-height:1.2!important;letter-spacing:.08em;white-space:normal;text-align:center}
</style>
<section class="pw-section" style="--pw-pad-top: {{ section.settings.pad_top }}px; --pw-pad-bottom: {{ section.settings.pad_bottom }}px">
  <div class="pw-wrap">
    <div class="pw-warranty">
      <div class="pw-warranty__badge" aria-hidden="true"><span>{{ section.settings.big }}</span><small>{{ section.settings.big_sub }}</small></div>
      <div class="pw-warranty__copy">
        <div class="pw-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="pw-h">{{ section.settings.heading }}</h2>
        <p class="pw-muted">{{ section.settings.text }}</p>
        <ul class="pw-ticks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              <span><strong>{{ block.settings.title }}</strong> {{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.legal != blank -%}<p class="pw-warranty__legal">{{ section.settings.legal }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PW Warranty",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "big", "label": "Badge number", "default": "2" },
    { "type": "text", "id": "big_sub", "label": "Badge text", "default": "YEARS+" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Warranty+" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two years of cover, plus no waiting around" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every product in our own range is covered for two years. If something goes wrong, we fix it fast." },
    { "type": "textarea", "id": "legal", "label": "Legal note (optional)" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [{ "type": "point", "name": "Point", "settings": [
    { "type": "text", "id": "title", "label": "Bold part", "default": "2-year cover" },
    { "type": "text", "id": "text", "label": "Text", "default": "on everything in our own range." }
  ]}],
  "presets": [{ "name": "PW Warranty" }]
}
{% endschema %}
