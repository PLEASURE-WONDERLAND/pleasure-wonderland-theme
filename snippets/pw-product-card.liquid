{% doc %}
  Pleasure Wonderland product card.
  @param {product} product - Product to show
  @param {string} [badge] - Optional badge text
  @param {string} [tint] - Optional background colour for the image area
{% enddoc %}
{%- liquid
  assign tint = tint | default: '#E9E1FF'
  assign badge_text = badge
  assign pw_saving = 0
  if product.compare_at_price > product.price
    assign pw_saving = product.compare_at_price | minus: product.price
  endif
  assign pw_gift = false
  if product.tags contains 'free-gift'
    assign pw_gift = true
  endif
  assign pw_thr = settings.pw_free_shipping | default: 69 | times: 100
  assign pw_ship = false
  if product.selected_or_first_available_variant.price >= pw_thr
    assign pw_ship = true
  endif
  assign colour_option = null
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'colour' or oname == 'color'
      assign colour_option = option
    endif
  endfor
  assign first_variant = product.selected_or_first_available_variant
-%}
<div class="pw-card">
  <a href="{{ product.url }}" class="pw-card__media" style="background: {{ tint }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title, widths: '360, 540, 720, 900, 1200', sizes: '(min-width: 1200px) 340px, (min-width: 990px) 25vw, 50vw' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pw-placeholder' }}
    {%- endif -%}
    {%- if badge_text != blank -%}
      <span class="pw-pill pw-pill--white pw-card__badge">{{ badge_text }}</span>
    {%- endif -%}
  </a>
  <div class="pw-card__body">
    <div class="pw-card__vendor">{{ product.vendor }}</div>
    <a href="{{ product.url }}" class="pw-card__title">{{ product.title }}</a>
    <div class="pw-card__swatches">
      {%- if colour_option -%}
        {%- for value in colour_option.values limit: 5 -%}
          {%- if value.swatch.color -%}
            {%- assign swatch_bg = value.swatch.color -%}
          {%- elsif value.swatch.image -%}
            {%- capture swatch_bg -%}url({{ value.swatch.image | image_url: width: 32 }}) center / cover{%- endcapture -%}
          {%- else -%}
            {%- liquid
              assign vkey = value | handleize
              case vkey
                when 'rose-gold'
                  assign swatch_bg = '#E3B7A0'
                when 'violet', 'purple', 'lilac'
                  assign swatch_bg = '#8E6CC9'
                when 'blue', 'navy'
                  assign swatch_bg = '#4A7FC1'
                when 'pink', 'rose'
                  assign swatch_bg = '#F2A7BE'
                when 'red', 'wine-red', 'berry'
                  assign swatch_bg = '#9E2B3E'
                when 'black'
                  assign swatch_bg = '#1D1530'
                when 'white'
                  assign swatch_bg = '#FFFFFF'
                when 'mint', 'green'
                  assign swatch_bg = '#9ED9C0'
                when 'gold'
                  assign swatch_bg = '#D4AF6A'
                else
                  assign swatch_bg = vkey | split: '-' | last
              endcase
            -%}
          {%- endif -%}
          <span class="pw-dot" style="background: {{ swatch_bg }}; box-shadow: inset 0 0 0 1px rgba(29,21,48,.15)" title="{{ value | escape }}"></span>
        {%- endfor -%}
        <span class="pw-muted" style="font-size: 13px; margin-left: 2px">
          {{- colour_option.values.size }} {% if colour_option.values.size == 1 %}colour{% else %}colours{% endif -%}
        </span>
      {%- endif -%}
    </div>
    <div class="pw-card__foot">
      <span class="pw-card__price">
        {%- if product.price_varies -%}From {% endif -%}
        {{- product.price | money -}}
        {%- if product.compare_at_price > product.price -%}
          <s class="pw-card__compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </span>
      {%- if product.has_only_default_variant and first_variant.available -%}
        <form method="post" action="{{ routes.cart_add_url }}" data-pw-quick-add>
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="pw-quickadd">Quick add</button>
        </form>
      {%- elsif product.available -%}
        <a href="{{ product.url }}" class="pw-quickadd" style="display: inline-flex; align-items: center; text-decoration: none">Choose</a>
      {%- else -%}
        <button type="button" class="pw-quickadd" disabled>Sold out</button>
      {%- endif -%}
    </div>
    {%- if pw_saving > 0 or pw_gift or pw_ship -%}
      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px">
        {%- if pw_saving > 0 -%}<span style="display: inline-flex; align-items: center; font-weight: 700; font-size: 12px; line-height: 1; padding: 5px 8px; border-radius: 6px; background: #FFE7E3; color: #D9412E">Save {{ pw_saving | money_without_trailing_zeros }}</span>{%- endif -%}
        {%- if pw_gift -%}<span style="display: inline-flex; align-items: center; font-weight: 700; font-size: 12px; line-height: 1; padding: 5px 8px; border-radius: 6px; background: #FF7A6B; color: #fff">Free gift</span>{%- endif -%}
        {%- if pw_ship -%}<span style="display: inline-flex; align-items: center; gap: 4px; font-weight: 700; font-size: 12px; line-height: 1; padding: 5px 8px; border-radius: 6px; background: #E3F3EC; color: #12694B"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>Free shipping</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
