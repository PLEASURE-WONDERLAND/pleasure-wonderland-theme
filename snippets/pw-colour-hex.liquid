{%- doc -%}
  Outputs a hex colour for a colour option value. Uses the Shopify swatch colour when set.
  @param {object} value - product option value
{%- enddoc -%}
{%- liquid
  if value.swatch.color
    echo value.swatch.color
  else
    assign vkey = value | handleize
    case vkey
      when 'rose-gold'
        echo '#E3B7A0'
      when 'violet', 'purple', 'lilac'
        echo '#8E6CC9'
      when 'blue', 'navy'
        echo '#4A7FC1'
      when 'pink', 'rose'
        echo '#F2A7BE'
      when 'red', 'wine-red', 'berry'
        echo '#9E2B3E'
      when 'black'
        echo '#1D1530'
      when 'white'
        echo '#FFFFFF'
      when 'mint', 'green'
        echo '#9ED9C0'
      when 'gold'
        echo '#D4AF6A'
      when 'teal'
        echo '#3BA7A0'
      when 'grey', 'gray', 'silver'
        echo '#B9B4C4'
      else
        echo '#5B3FD1'
    endcase
  endif
-%}
