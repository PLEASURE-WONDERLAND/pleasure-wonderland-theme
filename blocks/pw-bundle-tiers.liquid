{%- liquid
  assign main_p = product
  if main_p == blank
    assign main_p = closest.product
  endif
  assign variant = main_p.selected_or_first_available_variant
  assign a1 = block.settings.addon_1
  assign a2 = block.settings.addon_2
  assign base = variant.price
  assign t2_full = base
  if a1 != blank
    assign t2_full = t2_full | plus: a1.selected_or_first_available_variant.price
  endif
  assign t3_full = t2_full
  if a2 != blank
    assign t3_full = t3_full | plus: a2.selected_or_first_available_variant.price
  endif
  assign pct = block.settings.addon_percent
  assign addons2 = t2_full | minus: base
  assign addons3 = t3_full | minus: base
  assign t2_save = addons2 | times: pct | divided_by: 100
  assign t3_save = addons3 | times: pct | divided_by: 100
  assign t2_price = t2_full | minus: t2_save
  assign t3_price = t3_full | minus: t3_save
  comment
    Every toy page opens on Toy + lube. Add-on products (tagged addon or essentials) open on Just the toy. Kits and Control Room gear hide this block.
  endcomment
  assign default_tier = '2'
  assign tag_str = main_p.tags | join: ',' | downcase | prepend: ',' | append: ','
  if tag_str contains ',addon,' or tag_str contains ',essentials,'
    assign default_tier = '1'
  endif
  assign pw_skip = false
  if tag_str contains ',bundle,' or tag_str contains ',control-room,' or tag_str contains ',cr-component,'
    assign pw_skip = true
  endif
  assign t3_label = block.settings.tier3_label
  if t3_label == blank or t3_label == 'The Upgrade Kit'
    assign t3_label = 'Toy + lube + cleaner'
  endif
-%}
{%- if main_p != blank and a1 != blank and pw_skip == false -%}
<pw-bundle-tiers class="pw-tiers" data-default="{{ default_tier }}" data-variant-source {{ block.shopify_attributes }}>
  <div class="pw-tiers__label">{{ block.settings.heading }}</div>
  <div class="pw-tiers__options" role="radiogroup" aria-label="{{ block.settings.heading | escape }}">
    <label class="pw-tier">
      <input type="radio" name="pw-tier-{{ block.id }}" value="1" data-price="{{ base }}"{% if default_tier == "1" %} checked{% endif %}>
      <span class="pw-tier__radio" aria-hidden="true"></span>
      <span class="pw-tier__text"><strong>{{ block.settings.tier1_label }}</strong><span class="pw-muted">{{ main_p.title }}</span></span>
      <span class="pw-tier__price"><strong>{{ base | money }}</strong></span>
    </label>
    <label class="pw-tier">
      <input type="radio" name="pw-tier-{{ block.id }}" value="2" data-price="{{ t2_price }}"{% if default_tier == "2" %} checked{% endif %} data-items="{{ a1.selected_or_first_available_variant.id }}">
      <span class="pw-tier__radio" aria-hidden="true"></span>
      <span class="pw-tier__text"><strong>{{ block.settings.tier2_label }}</strong><span class="pw-muted">+ {{ a1.title }}</span></span>
      <span class="pw-tier__price"><strong>{{ t2_price | money }}</strong>{%- if t2_save > 0 -%}<span class="pw-tier__save">Save {{ t2_save | money }}</span>{%- endif -%}</span>
    </label>
    {%- if a2 != blank -%}
      <label class="pw-tier">
        <input type="radio" name="pw-tier-{{ block.id }}" value="3" data-price="{{ t3_price }}" data-items="{{ a1.selected_or_first_available_variant.id }},{{ a2.selected_or_first_available_variant.id }}">
        <span class="pw-tier__radio" aria-hidden="true"></span>
        <span class="pw-tier__text"><strong>{{ t3_label }}{% if block.settings.badge != blank %} <span class="pw-pill pw-pill--coral" style="padding: 3px 9px; font-size: 11px">{{ block.settings.badge }}</span>{% endif %}</strong><span class="pw-muted">+ {{ a1.title }} + {{ a2.title }}</span></span>
        <span class="pw-tier__price"><strong>{{ t3_price | money }}</strong>{%- if t3_save > 0 -%}<span class="pw-tier__save">Save {{ t3_save | money }}</span>{%- endif -%}</span>
      </label>
    {%- endif -%}
  </div>
  <p class="pw-tiers__msg" role="status" hidden></p>
</pw-bundle-tiers>

<script>
  if (!customElements.get('pw-bundle-tiers')) {
    customElements.define('pw-bundle-tiers', class extends HTMLElement {
      connectedCallback() {
        const def = this.querySelector('input[type="radio"][value="' + (this.dataset.default || '2') + '"]');
        if (def) def.checked = true;
        this.msg = this.querySelector('.pw-tiers__msg');
        this.scope = this.closest('.product-information, product-information, main') || document;
        this.onSubmit = (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement) || !this.scope.contains(form) || !form.closest('product-form-component')) return;
          const chosen = this.querySelector('input[type="radio"]:checked');
          if (!chosen || chosen.value === '1') return;
          e.preventDefault();
          e.stopImmediatePropagation();
          this.add(form);
        };
        document.addEventListener('submit', this.onSubmit, true);
        this.addEventListener('change', () => document.dispatchEvent(new CustomEvent('pw:tier')));
      }
      disconnectedCallback() { document.removeEventListener('submit', this.onSubmit, true); }
      mainVariantId() {
        const scope = this.closest('.product-information, product-information, main, body');
        const input = scope.querySelector('form[action*="/cart/add"] input[name="id"], product-form-component input[name="id"]');
        return input ? input.value : null;
      }
      async add(form) {
        const chosen = this.querySelector('input[type="radio"]:checked');
        const main = (form && form.querySelector('input[name="id"]')) ? form.querySelector('input[name="id"]').value : this.mainVariantId();
        const qty = form && form.querySelector('input[name="quantity"]') ? Number(form.querySelector('input[name="quantity"]').value) || 1 : 1;
        const btn = form && form.querySelector('button[type="submit"]');
        if (btn) btn.disabled = true;
        try {
          await window.pwAddToCart([{ id: main, quantity: qty }, ...(chosen.dataset.items || '').split(',').filter(Boolean).map((id) => ({ id }))], this);
          this.msg.hidden = true;
        } catch (e) {
          this.msg.hidden = false; this.msg.textContent = e.message;
        }
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "PW Bundle & save",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & save" },
    { "type": "product", "id": "addon_1", "label": "Add-on 1 (e.g. lube)" },
    { "type": "product", "id": "addon_2", "label": "Add-on 2 (e.g. toy cleaner)" },
    { "type": "text", "id": "default_tags", "label": "Not used", "info": "Every toy now opens on Toy + lube automatically. Products tagged addon or essentials open on Just the toy. Products tagged bundle, control-room or cr-component hide this block." },
    { "type": "text", "id": "tier1_label", "label": "Tier 1 label", "default": "Just the toy" },
    { "type": "text", "id": "tier2_label", "label": "Tier 2 label", "default": "Toy + lube" },
    { "type": "text", "id": "tier3_label", "label": "Tier 3 label", "default": "Toy + lube + cleaner" },
    { "type": "text", "id": "badge", "label": "Tier 3 badge", "default": "Most popular" },
    { "type": "range", "id": "addon_percent", "label": "Add-on discount", "min": 0, "max": 50, "step": 5, "unit": "%", "default": 20, "info": "Display only. Matches the automatic discount 'Bundle add-ons 20% off' (lube and cleaner, orders over $50). Change both together." }
  ]
}
{% endschema %}
