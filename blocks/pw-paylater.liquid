{%- liquid
  assign p = product | default: closest.product
  assign price = p.selected_or_first_available_variant.price
-%}
{%- if settings.pw_paypal_client_id != blank -%}
  <div
    class="pw-paylater"
    data-pp-message
    data-pp-placement="product"
    data-pp-amount="{{ price | divided_by: 100.0 }}"
    data-pp-style-layout="text"
    data-pp-style-logo-type="inline"
    data-pp-style-text-color="black"
    {{ block.shopify_attributes }}
  ></div>
{%- endif -%}
{% schema %}
{
  "name": "PW PayPal Pay in 4",
  "settings": [
    { "type": "paragraph", "content": "PayPal's official Pay Later message. Set the client ID in Theme settings > Pleasure Wonderland." }
  ],
  "presets": [{ "name": "PW PayPal Pay in 4" }]
}
{% endschema %}
