{%- assign is_third_party = false -%}
{%- if closest.product.tags contains 'third-party' -%}{%- assign is_third_party = true -%}{%- endif -%}
<div class="pw-trustgrid" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- capture t %}title_{{ i }}{% endcapture -%}
    {%- capture x %}text_{{ i }}{% endcapture -%}
    {%- assign tt = block.settings[t] -%}
    {%- assign tx = block.settings[x] -%}
    {%- if is_third_party and tt contains 'arranty' -%}
      {%- assign tt = block.settings.third_party_title | replace: '[vendor]', closest.product.vendor -%}
      {%- assign tx = block.settings.third_party_text -%}
    {%- endif -%}
    {%- if tt != blank -%}
      <div class="pw-trustgrid__item"><strong>{{ tt }}</strong><span class="pw-muted">{{ tx }}</span></div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "PW Trust grid",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Title 1", "default": "Plain-box delivery" },
    { "type": "text", "id": "text_1", "label": "Text 1", "default": "Discreet billing name" },
    { "type": "text", "id": "title_2", "label": "Title 2", "default": "Dispatched today" },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "Order by 2pm" },
    { "type": "text", "id": "title_3", "label": "Title 3", "default": "2-year warranty+" },
    { "type": "text", "id": "text_3", "label": "Text 3", "default": "Replacement sent first" },
    { "type": "text", "id": "title_4", "label": "Title 4", "default": "Free shipping over $69" },
    { "type": "text", "id": "text_4", "label": "Text 4", "default": "Australia-wide" },
    { "type": "header", "content": "Third-party products" },
    { "type": "paragraph", "content": "On products tagged third-party, any item mentioning a warranty is swapped for this one, because Warranty+ covers our own range only." },
    { "type": "text", "id": "third_party_title", "label": "Title", "default": "100% genuine [vendor]" },
    { "type": "text", "id": "third_party_text", "label": "Text", "default": "Held in stock in Australia" }
  ]
}
{% endschema %}
